<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TFSrun - Storage</title>
  <link rel="stylesheet" href="/css/s3.css">
</head>
<body class="s3-page">
  <header class="topbar">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">+</span>
      <h1>TFSrun</h1>
      <span class="brand-subtitle">/ storage</span>
    </div>
    <div class="user-info">
      <span class="account-label">STUDENT ACCOUNT</span>
      <span>Welcome, <strong><%= user %></strong></span>
      <a class="secondary-btn docs-btn" href="/student/s3/docs" title="How to connect your app to TFSrun object storage">Documentation</a>
      <form action="/api/auth/logout" method="post" class="logout-form">
        <button id="s3LogoutBtn" class="secondary-btn" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <main class="container">
    <section class="page-header">
      <div class="eyebrow">TFSrun / object storage</div>
      <h2>Storage workspace</h2>
      <p>Buckets, objects, and application keys. MinIO enforces authorization independently of this portal<% if (username) { %> — signed in to MinIO as <code><%= username %></code><% } %>.</p>
      <div class="welcome-line" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </section>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>
    <% if (storageError) { %><div class="alert error"><%= storageError %></div><% } %>

    <% if (integration) { %>
    <section class="section">
      <div class="alert info"><strong>Save these credentials now.</strong> The secret is shown only once and will not be displayed again.</div>
      <div class="panel">
        <h3>Application connection details</h3>
        <div class="credential-grid">
          <strong>Endpoint</strong><code><%= integration.endpoint %></code>
          <strong>Bucket</strong><code><%= integration.bucketName %></code>
          <strong>Region</strong><code><%= integration.region %></code>
          <strong>Access key</strong><code><%= integration.accessKey %></code>
          <strong>Secret key</strong><code><%= integration.secretKey %></code>
        </div>
        <p class="muted small">Use these values with any S3-compatible SDK. Do not use them in browser-side JavaScript.</p>
      </div>
    </section>
    <% } %>

    <section class="section">
      <div class="section-header">
        <h3>Your buckets</h3>
        <form action="/student/s3/create-bucket" method="post" class="row">
          <input type="text" name="label" placeholder="New bucket label, e.g. backups" pattern="[A-Za-z0-9-]{1,24}" required>
          <button class="button primary" type="submit">Create bucket</button>
        </form>
      </div>
      <p class="muted small">Only buckets owned by your account are shown. The portal and MinIO both enforce ownership.</p>
      <div class="panel table-panel">
        <div class="table-wrapper">
          <table>
            <thead><tr><th>Bucket</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>
              <% if (!buckets.length) { %><tr><td colspan="3" class="muted" style="text-align:center;">No buckets yet.</td></tr><% } %>
              <% buckets.forEach(item => { %>
                <tr>
                  <td><code><%= item.name %></code><% if (item.name === bucket) { %> <span class="status active">selected</span><% } %></td>
                  <td class="muted"><%= item.createdAt ? new Date(item.createdAt).toLocaleString() : '—' %></td>
                  <td>
                    <div class="actions">
                      <form action="/student/s3/select-bucket" method="post"><input type="hidden" name="bucketName" value="<%= item.name %>"><button class="button secondary" type="submit">Open</button></form>
                      <form action="/student/s3/create-integration" method="post"><input type="hidden" name="bucketName" value="<%= item.name %>"><input type="hidden" name="label" value="application"><button class="button secondary" type="submit">Create app key</button></form>
                      <% if (item.name !== bucket) { %><form action="/student/s3/delete-bucket" method="post" onsubmit="return confirm('Delete empty bucket <%= item.name %>? This cannot be undone.');"><input type="hidden" name="bucketName" value="<%= item.name %>"><button class="button danger" type="submit">Delete</button></form><% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h3>Selected bucket: <code><%= bucket %></code></h3>
        <form action="/student/s3/upload" method="post" enctype="multipart/form-data" class="row">
          <input type="file" name="file" required>
          <button class="button primary" type="submit">Upload</button>
        </form>
      </div>
      <p class="muted small">No upload size limit. Files are stored in the selected user-owned bucket.</p>
    </section>

    <section class="section">
      <div class="section-header"><h3>Files in selected bucket</h3></div>
      <div class="panel table-panel">
        <div class="table-wrapper">
          <table>
            <thead><tr><th>File name</th><th>Size</th><th>Actions</th></tr></thead>
            <tbody>
              <% if (!files.length) { %><tr><td colspan="3" class="muted" style="text-align:center;">Bucket is empty.</td></tr><% } %>
              <% files.forEach(file => { %>
                <tr>
                  <td><code><%= file.Key %></code></td>
                  <td class="muted"><%= (Number(file.Size || 0) / 1024).toFixed(1) %> KB</td>
                  <td>
                    <div class="actions">
                      <a class="button secondary" href="/student/s3/download?key=<%= encodeURIComponent(file.Key) %>">Download</a>
                      <form action="/student/s3/delete" method="post"><input type="hidden" name="key" value="<%= file.Key %>"><button class="button danger" type="submit">Delete</button></form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header"><h3>Application integrations</h3></div>
      <p class="muted small">Each integration receives a unique MinIO-generated access-key/secret-key pair scoped to its bucket. Secrets are shown only when created.</p>
      <% if (!integrations.length) { %><p class="muted small">No application keys have been created.</p><% } %>
      <% integrations.forEach(item => { %>
        <div class="panel integration-card">
          <div class="integration-head">
            <strong><%= item.name %></strong>
            <form action="/student/s3/delete-integration" method="post" onsubmit="return confirm('Remove access key <%= item.accessKey %>? Applications using it will lose access.');"><input type="hidden" name="accessKey" value="<%= item.accessKey %>"><button class="button danger" type="submit">Remove key</button></form>
          </div>
          <p class="muted small">Bucket: <code><%= item.bucketName %></code> · Access key: <code><%= item.accessKey %></code> · Created: <%= new Date(item.createdAt).toLocaleString() %></p>
        </div>
      <% }) %>
    </section>
  </main>
  <script src="/js/s3.js"></script>
</body>
</html>
