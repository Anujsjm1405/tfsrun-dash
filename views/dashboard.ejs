<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TFSrun - Student Dashboard</title>

    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

<header class="topbar">

    <div class="brand">
        <span class="brand-mark" aria-hidden="true">+</span>
        <h1>TFSrun</h1>
    </div>

    <div class="user-info">
        <span class="account-label">STUDENT ACCOUNT</span>
        <span>
            Welcome,
            <strong><%= user.name || user.prn %></strong>
        </span>

        <button
            id="logoutBtn"
            class="secondary-btn">
            Logout
        </button>
    </div>

</header>


<main class="container">

    <section class="welcome-section">

        <div class="eyebrow">TFSrun / student portal</div>

        <h2>
            Welcome, <%= user.name || user.prn %>
        </h2>

        <p>
            Choose a service to get started.
        </p>

        <div class="welcome-line" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

    </section>


    <section class="service-categories">

        <a
            href="/student/compute"
            class="service-card">

            <div class="service-icon">
                VM
            </div>

            <div class="service-index">01 / AVAILABLE</div>

            <h3>
                Compute
            </h3>

            <p>
                Create and manage virtual machines.
            </p>

            <span class="card-arrow" aria-hidden="true">↗</span>

        </a>


        <div
            class="service-card disabled">

            <div class="service-icon">
                S3
            </div>

            <div class="service-index">02 / IN DEVELOPMENT</div>

            <h3>
                Storage
            </h3>

            <p>
                Object storage for your applications.
            </p>

            <span class="coming-soon">
                Coming soon
            </span>

        </div>


        <div
            class="service-card disabled">

            <div class="service-icon">
                DB
            </div>

            <div class="service-index">03 / IN DEVELOPMENT</div>

            <h3>
                Database
            </h3>

            <p>
                Managed database services.
            </p>

            <span class="coming-soon">
                Coming soon
            </span>

        </div>

    </section>

</main>


<script>

async function logout() {

    try {

        const response =
            await fetch(
                "/api/auth/logout",
                {
                    method: "POST"
                }
            );

        const data =
            await response.json();

        if (!response.ok) {
            throw new Error(
                data.error ||
                "Logout failed"
            );
        }

        window.location.href =
            "/login";

    } catch (error) {

        alert(error.message);
    }
}


document
    .getElementById("logoutBtn")
    .addEventListener(
        "click",
        logout
    );

</script>

</body>
</html>
