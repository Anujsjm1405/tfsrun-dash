<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        rel="stylesheet"
        href="/css/auth.css"
    >
</head>

<body>

    <div class="auth-container">

        <div class="auth-card">

            <div class="brand">
                TFSrun
            </div>

            <h1>
                Student Login
            </h1>

            <p class="subtitle">
                Login using your PRN
            </p>


            <form id="loginForm">

                <div class="form-group">

                    <label for="prn">
                        PRN
                    </label>

                    <input
                        type="text"
                        id="prn"
                        required
                        autocomplete="username"
                        placeholder="Enter your PRN"
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        required
                        autocomplete="current-password"
                        placeholder="Enter your password"
                    >

                </div>


                <button
                    type="submit"
                    id="loginButton"
                    class="button"
                >
                    Login
                </button>

            </form>


            <div
                id="message"
                class="message hidden"
            ></div>


            <p class="auth-link">
                Don't have an account?

                <a href="/register">
                    Register
                </a>
            </p>

        </div>

    </div>


    <script src="/js/auth.js"></script>

</body>

</html>
