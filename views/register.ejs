<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %></title>

    <link
        rel="stylesheet"
        href="/css/auth.css"
    >
</head>

<body>

    <div class="auth-container">

        <div class="auth-card">

            <div class="brand">
                TFSrun
            </div>

            <h1>
                Student Registration
            </h1>

            <p class="subtitle">
                Create your TFSrun student account
            </p>


            <form id="registerForm">

                <div class="form-group">

                    <label for="prn">
                        PRN
                    </label>

                    <input
                        type="text"
                        id="prn"
                        required
                        maxlength="50"
                        autocomplete="username"
                        placeholder="Enter your PRN"
                    >

                </div>


                <div class="form-group">

                    <label for="name">
                        Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        required
                        maxlength="100"
                        autocomplete="name"
                        placeholder="Enter your full name"
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        required
                        minlength="8"
                        autocomplete="new-password"
                        placeholder="Minimum 8 characters"
                    >

                </div>


                <div class="form-group">

                    <label for="confirmPassword">
                        Confirm Password
                    </label>

                    <input
                        type="password"
                        id="confirmPassword"
                        required
                        minlength="8"
                        autocomplete="new-password"
                        placeholder="Re-enter your password"
                    >

                </div>


                <button
                    type="submit"
                    id="registerButton"
                    class="button"
                >
                    Register
                </button>

            </form>


            <div
                id="message"
                class="message hidden"
            ></div>


            <p class="auth-link">
                Already have an account?

                <a href="/login">
                    Login
                </a>
            </p>

        </div>

    </div>


    <script src="/js/auth.js"></script>

</body>

</html>
