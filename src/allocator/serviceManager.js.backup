const pool = require("../db/mysql");
const allocator = require("./resourceAllocator");
const ProxmoxClient = require("../proxmox/proxmoxClient");
const proxmoxConfig = require("../config/proxmox");

class ServiceManager {
    getClient(nodeName) {
        const config = proxmoxConfig[nodeName];

        if (!config) {
            throw new Error(`Unknown Proxmox node: ${nodeName}`);
        }

        return new ProxmoxClient(config);
    }

    async getTemplate(serviceType) {
        const [rows] = await pool.execute(
            `
            SELECT
                t.id,
                t.service_type,
                t.node_id,
                t.vmid,
                t.name,
                t.storage_gb,
                n.name AS node_name
            FROM templates t
            JOIN nodes n ON n.id = t.node_id
            WHERE t.service_type = ?
              AND t.enabled = TRUE
            ORDER BY t.id
            LIMIT 1
            `,
            [serviceType]
        );

        if (!rows.length) {
            throw new Error(
                `No template available for ${serviceType}`
            );
        }

        return rows[0];
    }

    async getNextVMID(nodeName) {
        const client = this.getClient(nodeName);

        const [vms, containers] = await Promise.all([
            client.getVMs(nodeName),
            client.getContainers(nodeName)
        ]);

        const used = new Set([
            ...vms.map(vm => Number(vm.vmid)),
            ...containers.map(ct => Number(ct.vmid))
        ]);

        let vmid = 1000;

        while (used.has(vmid)) {
            vmid++;
        }

        return vmid;
    }

    async waitForTask(
        nodeName,
        upid,
        timeoutMs = 120000
    ) {
        const client = this.getClient(nodeName);
        const started = Date.now();

        while (Date.now() - started < timeoutMs) {
            const status =
                await client.getTaskStatus(
                    nodeName,
                    upid
                );

            if (status.status === "stopped") {
                if (status.exitstatus !== "OK") {
                    throw new Error(
                        `Proxmox task failed: ${status.exitstatus}`
                    );
                }

                return status;
            }

            await new Promise(resolve =>
                setTimeout(resolve, 1000)
            );
        }

        throw new Error(
            "Proxmox task timed out"
        );
    }

    async createService({
        serviceType,
        name,
        cpu,
        ramMb,
        storageGb
    }) {
        if (!serviceType) {
            throw new Error(
                "serviceType is required"
            );
        }

        if (!name) {
            throw new Error(
                "Service name is required"
            );
        }

        if (!Number.isInteger(cpu) || cpu <= 0) {
            throw new Error(
                "CPU must be a positive integer"
            );
        }

        if (!Number.isInteger(ramMb) || ramMb <= 0) {
            throw new Error(
                "RAM must be a positive integer"
            );
        }

        if (
            !Number.isFinite(storageGb) ||
            storageGb <= 0
        ) {
            throw new Error(
                "Storage must be greater than zero"
            );
        }

        const template =
            await this.getTemplate(
                serviceType
            );

        /*
         * Templates are currently node-local.
         * Therefore the service must be created
         * on the same node as its template.
         */
        const node =
            await allocator.findNode({
                cpu,
                ramMb,
                storageGb,
                storageType: "local",
                preferredNodeId: template.node_id
            });

        if (!node) {
            throw new Error(
                `Insufficient resources on ${template.node_name}`
            );
        }

        /*
         * Reserve resources in MySQL before
         * touching Proxmox.
         */
        const connection =
            await pool.getConnection();

        let serviceId;

        try {
            await connection.beginTransaction();

            /*
             * Lock the node row so concurrent
             * requests cannot allocate the same
             * remaining resources.
             */
            const [lockedNodes] =
                await connection.execute(
                    `
                    SELECT id
                    FROM nodes
                    WHERE id = ?
                      AND enabled = TRUE
                    FOR UPDATE
                    `,
                    [node.id]
                );

            if (!lockedNodes.length) {
                throw new Error(
                    "Node is unavailable"
                );
            }

            /*
             * Recalculate resources while the
             * node is locked.
             */
            const resources =
                await allocator.getNodeResources(
                    node.id,
                    connection
                );

            if (
                resources.cpu.available <
                cpu
            ) {
                throw new Error(
                    "Insufficient CPU"
                );
            }

            if (
                resources.ram.available <
                ramMb
            ) {
                throw new Error(
                    "Insufficient RAM"
                );
            }

            const localStorageAvailable =
                resources.storage.total -
                resources.storage.reserved -
                resources.storage.localAllocated;

            if (
                localStorageAvailable <
                storageGb
            ) {
                throw new Error(
                    "Insufficient local storage"
                );
            }

            /*
             * Create service record.
             */
            const [serviceResult] =
                await connection.execute(
                    `
                    INSERT INTO services (
                        service_type,
                        name,
                        node_id,
                        status
                    )
                    VALUES (
                        ?, ?, ?, 'provisioning'
                    )
                    `,
                    [
                        serviceType,
                        name,
                        node.id
                    ]
                );

            serviceId =
                serviceResult.insertId;

            /*
             * Reserve resources permanently
             * until the service is deleted.
             */
            await connection.execute(
                `
                INSERT INTO allocations (
                    service_id,
                    node_id,
                    cpu,
                    ram_mb,
                    storage_gb,
                    storage_type,
                    allocation_type,
                    status
                )
                VALUES (
                    ?,
                    ?,
                    ?,
                    ?,
                    ?,
                    'local',
                    'service',
                    'active'
                )
                `,
                [
                    serviceId,
                    node.id,
                    cpu,
                    ramMb,
                    storageGb
                ]
            );

            await connection.commit();
        } catch (error) {
            await connection.rollback();
            throw error;
        } finally {
            connection.release();
        }

        /*
         * Database reservation succeeded.
         * Now create the actual Proxmox resource.
         */
        try {
            const vmid =
                await this.getNextVMID(
                    node.name
                );

            const client =
                this.getClient(
                    node.name
                );

            let upid;

            /*
             * Compute = QEMU VM
             * Database = LXC container
             */
            if (
                serviceType === "compute"
            ) {
                upid =
                    await client.cloneVM(
                        node.name,
                        template.vmid,
                        vmid,
                        name
                    );
            } else if (
                serviceType === "database"
            ) {
                upid =
                    await client.cloneContainer(
                        node.name,
                        template.vmid,
                        vmid,
                        name
                    );
            } else {
                throw new Error(
                    `Unsupported service type: ${serviceType}`
                );
            }

            /*
             * Wait for clone operation.
             */
            await this.waitForTask(
                node.name,
                upid
            );

            /*
             * Configure CPU and RAM.
             */
            if (
                serviceType === "compute"
            ) {
                await client.setVMResources(
                    node.name,
                    vmid,
                    {
                        cores: cpu,
                        memory: ramMb
                    }
                );
            } else if (
                serviceType === "database"
            ) {
                await client.setContainerResources(
                    node.name,
                    vmid,
                    {
                        cores: cpu,
                        memory: ramMb
                    }
                );
            }

            /*
             * Save VM/CT ID before starting.
             */
            await pool.execute(
                `
                UPDATE services
                SET
                    vmid = ?,
                    status = 'active'
                WHERE id = ?
                `,
                [
                    vmid,
                    serviceId
                ]
            );

            /*
             * Start resource.
             */
            if (
                serviceType === "compute"
            ) {
                await client.startVM(
                    node.name,
                    vmid
                );
            } else if (
                serviceType === "database"
            ) {
                await client.startContainer(
                    node.name,
                    vmid
                );
            }

            return {
                serviceId,
                serviceType,
                name,
                nodeId: node.id,
                node: node.name,
                vmid,
                cpu,
                ramMb,
                storageGb,
                status: "active"
            };
        } catch (error) {
            /*
             * Proxmox provisioning failed.
             * Release the allocation.
             */
            await allocator.release(
                serviceId
            );

            await pool.execute(
                `
                UPDATE services
                SET status = 'failed'
                WHERE id = ?
                `,
                [serviceId]
            );

            throw error;
        }
    }

    async deleteService(serviceId) {
        const [rows] =
            await pool.execute(
                `
                SELECT
                    s.id,
                    s.service_type,
                    s.vmid,
                    s.status,
                    n.name AS node_name
                FROM services s
                JOIN nodes n
                    ON n.id = s.node_id
                WHERE s.id = ?
                `,
                [serviceId]
            );

        if (!rows.length) {
            throw new Error(
                "Service not found"
            );
        }

        const service = rows[0];

        /*
         * Infrastructure allocations must
         * never be released through a normal
         * student service deletion.
         */
        const [allocations] =
            await pool.execute(
                `
                SELECT allocation_type
                FROM allocations
                WHERE service_id = ?
                  AND status = 'active'
                `,
                [serviceId]
            );

        if (
            allocations.some(
                allocation =>
                    allocation.allocation_type ===
                    "infrastructure"
            )
        ) {
            throw new Error(
                "Infrastructure service cannot be deleted"
            );
        }

        await pool.execute(
            `
            UPDATE services
            SET status = 'deleting'
            WHERE id = ?
            `,
            [serviceId]
        );

        try {
            if (service.vmid) {
                const client =
                    this.getClient(
                        service.node_name
                    );

                /*
                 * Stop resource.
                 */
                try {
                    if (
                        service.service_type ===
                        "compute"
                    ) {
                        await client.stopVM(
                            service.node_name,
                            service.vmid
                        );
                    } else if (
                        service.service_type ===
                        "database"
                    ) {
                        await client.stopContainer(
                            service.node_name,
                            service.vmid
                        );
                    }
                } catch (_) {
                    /*
                     * Resource may already be stopped.
                     */
                }

                /*
                 * Delete resource.
                 */
                if (
                    service.service_type ===
                    "compute"
                ) {
                    await client.deleteVM(
                        service.node_name,
                        service.vmid
                    );
                } else if (
                    service.service_type ===
                    "database"
                ) {
                    await client.deleteContainer(
                        service.node_name,
                        service.vmid
                    );
                }
            }

            /*
             * Release CPU/RAM/storage only
             * after Proxmox deletion succeeds.
             */
            await allocator.release(
                serviceId
            );

            await pool.execute(
                `
                UPDATE services
                SET status = 'deleted'
                WHERE id = ?
                `,
                [serviceId]
            );

            return {
                serviceId,
                status: "deleted"
            };
        } catch (error) {
            await pool.execute(
                `
                UPDATE services
                SET status = 'active'
                WHERE id = ?
                `,
                [serviceId]
            );

            throw error;
        }
    }
}

module.exports = new ServiceManager();
