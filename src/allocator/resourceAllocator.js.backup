const pool = require("../db/mysql");

class ResourceAllocator {
    async getNodeResources(nodeId, connection = pool) {
        const [nodes] = await connection.execute(
            `
            SELECT
                n.id,
                n.name,
                n.total_cpu,
                n.reserved_cpu,
                n.total_ram_mb,
                n.reserved_ram_mb,
                n.total_storage_gb,
                n.reserved_storage_gb,

                COALESCE(SUM(
                    CASE
                        WHEN a.status = 'active'
                        THEN a.cpu
                        ELSE 0
                    END
                ), 0) AS allocated_cpu,

                COALESCE(SUM(
                    CASE
                        WHEN a.status = 'active'
                        THEN a.ram_mb
                        ELSE 0
                    END
                ), 0) AS allocated_ram_mb,

                COALESCE(SUM(
                    CASE
                        WHEN a.status = 'active'
                         AND a.storage_type = 'local'
                        THEN a.storage_gb
                        ELSE 0
                    END
                ), 0) AS allocated_local_storage_gb,

                COALESCE(SUM(
                    CASE
                        WHEN a.status = 'active'
                         AND a.storage_type = 'ssd'
                        THEN a.storage_gb
                        ELSE 0
                    END
                ), 0) AS allocated_ssd_storage_gb

            FROM nodes n
            LEFT JOIN allocations a
                ON a.node_id = n.id

            WHERE n.id = ?

            GROUP BY n.id
            `,
            [nodeId]
        );

        if (!nodes.length) {
            throw new Error(`Node ${nodeId} not found`);
        }

        const node = nodes[0];

        return {
            id: node.id,
            name: node.name,

            cpu: {
                total: Number(node.total_cpu),
                reserved: Number(node.reserved_cpu),
                allocated: Number(node.allocated_cpu),
                available:
                    Number(node.total_cpu) -
                    Number(node.reserved_cpu) -
                    Number(node.allocated_cpu)
            },

            ram: {
                total: Number(node.total_ram_mb),
                reserved: Number(node.reserved_ram_mb),
                allocated: Number(node.allocated_ram_mb),
                available:
                    Number(node.total_ram_mb) -
                    Number(node.reserved_ram_mb) -
                    Number(node.allocated_ram_mb)
            },

            storage: {
                total: Number(node.total_storage_gb),
                reserved: Number(node.reserved_storage_gb),
                localAllocated: Number(node.allocated_local_storage_gb),
                ssdAllocated: Number(node.allocated_ssd_storage_gb)
            }
        };
    }

    async getAllNodeResources() {
        const [nodes] = await pool.execute(
            "SELECT id FROM nodes WHERE enabled = TRUE ORDER BY id"
        );

        const result = [];

        for (const node of nodes) {
            result.push(
                await this.getNodeResources(node.id)
            );
        }

        return result;
    }

    async findNode({
        cpu,
        ramMb,
        storageGb = 0,
        storageType = "local",
        preferredNodeId = null
    }) {
        const nodes = await this.getAllNodeResources();

        const candidates = nodes.filter(node => {
            if (preferredNodeId && node.id !== preferredNodeId) {
                return false;
            }

            if (node.cpu.available < cpu) {
                return false;
            }

            if (node.ram.available < ramMb) {
                return false;
            }

            if (storageType === "ssd") {
                const available =
                    node.storage.total -
                    node.storage.reserved -
                    node.storage.ssdAllocated;

                if (available < storageGb) {
                    return false;
                }
            }

            if (storageType === "local") {
                const available =
                    node.storage.total -
                    node.storage.reserved -
                    node.storage.localAllocated;

                if (available < storageGb) {
                    return false;
                }
            }

            return true;
        });

        if (!candidates.length) {
            return null;
        }

        // Best-fit:
        // choose the node with the least remaining CPU
        // after allocation.
        candidates.sort((a, b) => {
            const cpuA = a.cpu.available - cpu;
            const cpuB = b.cpu.available - cpu;

            return cpuA - cpuB;
        });

        return candidates[0];
    }

    async allocate({
        serviceId,
        nodeId,
        cpu,
        ramMb,
        storageGb = 0,
        storageType = "local"
    }) {
        const connection = await pool.getConnection();

        try {
            await connection.beginTransaction();

            // Lock node row to prevent concurrent allocations
            // from selecting the same resources.
            const [nodes] = await connection.execute(
                `
                SELECT id
                FROM nodes
                WHERE id = ?
                  AND enabled = TRUE
                FOR UPDATE
                `,
                [nodeId]
            );

            if (!nodes.length) {
                throw new Error("Node unavailable");
            }

            const resources =
                await this.getNodeResources(
                    nodeId,
                    connection
                );

            if (resources.cpu.available < cpu) {
                throw new Error("Insufficient CPU");
            }

            if (resources.ram.available < ramMb) {
                throw new Error("Insufficient RAM");
            }

            if (storageType === "ssd") {
                const available =
                    resources.storage.total -
                    resources.storage.reserved -
                    resources.storage.ssdAllocated;

                if (available < storageGb) {
                    throw new Error("Insufficient SSD storage");
                }
            }

            if (storageType === "local") {
                const available =
                    resources.storage.total -
                    resources.storage.reserved -
                    resources.storage.localAllocated;

                if (available < storageGb) {
                    throw new Error("Insufficient local storage");
                }
            }

            const [result] = await connection.execute(
                `
                INSERT INTO allocations (
                    service_id,
                    node_id,
                    cpu,
                    ram_mb,
                    storage_gb,
                    storage_type,
                    status
                )
                VALUES (?, ?, ?, ?, ?, ?, 'active')
                `,
                [
                    serviceId,
                    nodeId,
                    cpu,
                    ramMb,
                    storageGb,
                    storageType
                ]
            );

            await connection.commit();

            return {
                id: result.insertId,
                serviceId,
                nodeId,
                cpu,
                ramMb,
                storageGb,
                storageType,
                status: "active"
            };
        } catch (error) {
            await connection.rollback();
            throw error;
        } finally {
            connection.release();
        }
    }

    async release(serviceId) {
        const connection = await pool.getConnection();

        try {
            await connection.beginTransaction();

            const [result] = await connection.execute(
                `
                UPDATE allocations
                SET
                    status = 'released',
                    released_at = NOW()
                WHERE service_id = ?
                  AND status = 'active'
                `,
                [serviceId]
            );

            await connection.commit();

            return result.affectedRows;
        } catch (error) {
            await connection.rollback();
            throw error;
        } finally {
            connection.release();
        }
    }
}

module.exports = new ResourceAllocator();
